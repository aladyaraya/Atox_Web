# Copy to deploy/.env privately; NEVER overwrite an existing file.
# Company-owned domain and DNS. Do not include a scheme here.
SITE_DOMAIN=website.example.com
TLS_CONTACT_EMAIL=operations@example.com
RELEASE_ID=
LAUNCH_APPROVED=false
# Initially BASIC AUTH protected. Change only after all release gates pass.
CADDY_CONFIG=./Caddyfile.staging
STAGING_USER=reviewer
# Generate interactively with caddy hash-password; do not put plaintext in argv.
STAGING_PASSWORD_HASH=
# Each value below must be a DIFFERENT randomly generated 64-character hex string.
AUTH_SECRET=
DB_BOOTSTRAP_PASSWORD=
APP_DB_PASSWORD=
MIGRATOR_DB_PASSWORD=
BACKUP_ENCRYPTION_KEY=
# Approved transactional sender domain. This is NOT the local QQ mailbox.
MAIL_DOMAIN_VERIFIED=false
MAIL_FROM_NAME=Your organization
AUTH_MAX_SENDS_PER_HOUR=10000
SMTP_HOST=smtpdm-ap-southeast-1.aliyuncs.com
SMTP_USER=no-reply@mail.example.com
SMTP_FROM=no-reply@mail.example.com
SMTP_PASSWORD=
# Private Hong Kong buckets; block public ACL, enable versioning.
OSS_BUCKET=
OSS_PREFIX=production/
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
BACKUP_BUCKET=
BACKUP_ACCESS_KEY_ID=
BACKUP_ACCESS_KEY_SECRET=
# No real secret values belong in a pull request or deployment log.
