# Copy to .data/mail-test/.env.local, never to the root .env.local.
# Generate AUTH_SECRET locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_FROM=
# QQ client authorization code, not the QQ login password.
SMTP_PASSWORD=
MAIL_TEST_RECIPIENT=
