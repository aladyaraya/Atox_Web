# Isolated LAB ONLY. `npm run init` generates .env.lab with random local secrets.
# Never copy values from the main website's .env.local.
NODE_ENV=development
ENABLE_LOGTO_LAB=true
LOGTO_LAB_ACK=isolated-loopback-test-only
LOGTO_LAB_POSTGRES_PASSWORD=
# Generated URL refers only to Compose postgres:5432/m013_logto_lab.
LOGTO_LAB_DB_URL=
LOGTO_LAB_BOOTSTRAP_SECRET=
LOGTO_LAB_COOKIE_SECRET_A=
LOGTO_LAB_COOKIE_SECRET_B=
# Ports, issuer, DB name and callback URLs are intentionally fixed in source.
# Not a production configuration; SMTP delivers only to Mailpit.
