{
  "name": "atox-m013-logto-oidc-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "init": "node scripts/init.mjs",
    "up": "node scripts/compose.mjs up -d --wait",
    "down": "node scripts/compose.mjs down",
    "provision": "node scripts/provision.mjs",
    "start:a": "node app/start.mjs a",
