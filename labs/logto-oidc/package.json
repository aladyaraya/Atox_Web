    "test:oidc": "playwright test --config=playwright.config.mjs"
  },
  "dependencies": {
    "@logto/node": "4.0.1",
    "express": "5.1.0",
    "express-session": "1.18.2"
  },
  "devDependencies": { "@playwright/test": "1.64.0" }
}
