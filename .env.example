# 首次本机开发示例；已有 .env.local 不要覆盖。真实凭据不提交。
APP_ORIGIN=http://localhost:3000
AUTH_SECRET=
DB_PATH=.data/pglite
UPLOAD_PATH=.data/uploads
TRUST_PROXY=false
# 默认使用开发邮箱；网站真实发信时改 smtp，并关闭开发邮箱。
MAIL_TRANSPORT=dev
ENABLE_DEV_MAIL=true
# sandbox 保留 3105 隔离测试；website 用于日常本机官网。
MAIL_LOCAL_SCOPE=sandbox
# website 默认只接受本工作树 .data 内数据库。跨工作树复用原数据时显式指定其 .data 绝对路径。
MAIL_WEBSITE_DATA_ROOT=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_FROM=
SMTP_PASSWORD=
# 下列两项仅用于 sandbox，website 接受任意单个有效收件邮箱。
MAIL_TEST_RECIPIENT=
MAIL_TEST_ALLOW_ANY_RECIPIENT=false
# NEXT_DIST_DIR=.next-ci
# 生产环境不启用本机投递。独立模块的配置只在对应分支维护。

# M014 local website OIDC. Disabled by default and ALWAYS closed in production.
# Prefer `npm run oidc:preview`: separate port 3104 and .data/oidc-sandbox/local DB.
# This launcher reads the third client provisioned by labs/logto-oidc, not this file.
ENABLE_LOGTO_LOGIN=false
LOGTO_ENDPOINT=
LOGTO_ISSUER=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
# Separate random 32+ character encryption key; never reuse AUTH_SECRET.
OIDC_ENCRYPTION_SECRET=
# local-sandbox requires loopback services AND DB_PATH inside .data/oidc-sandbox/.
# verified-email requires independently reviewed real delivery and provider config.
OIDC_EMAIL_TRUST=
OIDC_VERIFIED_EMAIL_ACK=
# Increment to invalidate ALL website OIDC sessions without changing legacy ones.
OIDC_SESSION_VERSION=1
